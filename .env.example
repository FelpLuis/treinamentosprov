# /etc/treinamentos-updown.env — variáveis dos Treinamentos UPDOWN (systemd EnvironmentFile)
HOST=127.0.0.1
PORT=8791
# Endereço público desta plataforma
PUBLIC_URL=https://treinamentos.updown.com.br
# Portal de login: endereço público (para onde o usuário vai entrar) e interno (consulta servidor a servidor)
PORTAL_URL=https://portal.updown.com.br
PORTAL_INTERNO=http://127.0.0.1:8790
# Dados: treinamentos editados, mídias enviadas, progresso e buscas
DATA_DIR=/var/lib/treinamentos-updown
# Tamanho máximo de um arquivo enviado (vídeos)
MAX_UPLOAD_MB=1024
